# ─────────────────────────────────────────────────────────────
# SP Builders — Environment Variables (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# ── Core ──
NODE_ENV=development

# ── API (NestJS) ──
API_PORT=4000
API_GLOBAL_PREFIX=api
API_VERSION=1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── PostgreSQL / Prisma ──
DATABASE_URL="postgresql://spb:spb@localhost:5432/spbuilders?schema=public"
# Direct URL for migrations when using a pooled connection (e.g. PgBouncer/Supabase)
DIRECT_URL="postgresql://spb:spb@localhost:5432/spbuilders?schema=public"

# ── Redis (cache, queues, socket adapter) ──
REDIS_URL="redis://localhost:6379"

# ── JWT / Auth ──
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="30d"
BCRYPT_ROUNDS=12

# ── Google OAuth ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# ── AWS S3 (compatible storage: AWS / MinIO / R2) ──
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="spb-media"
S3_PUBLIC_URL="http://localhost:9000/spb-media"
S3_FORCE_PATH_STYLE=true

# ── Notifications ──
# ── Outbound mail ──
# Used by the website's /api/lead route to notify the sales inbox of a new
# contact-form enquiry. Without all three of HOST/USER/PASS the enquiry is
# still saved to the database (site.enquiries), but no email is sent.
# For a royalnestrealty.in mailbox on Hostinger:
#   SMTP_HOST="smtp.hostinger.com"   SMTP_PORT=465   SMTP_USER="info@royalnestrealty.in"
# Port 465 uses implicit TLS; 587 upgrades via STARTTLS. Both work.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
# Must be a mailbox the SMTP account is allowed to send as, or the relay will
# reject it (and SPF/DMARC will fail even if it doesn't).
SMTP_FROM="RoyalNest Realty <info@royalnestrealty.in>"
# Where contact-form enquiries are delivered. Defaults to info@royalnestrealty.in.
LEAD_INBOX="info@royalnestrealty.in"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# ── Frontend (Next.js public vars) ──
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
# robots.txt only allows indexing when NEXT_PUBLIC_SITE_URL is a non-localhost
# https origin. Set this to "true" to force indexing on (e.g. a custom staging
# domain you do want indexed); leave it unset everywhere else.
NEXT_PUBLIC_ALLOW_INDEXING=""

# ── Production content store & publish auth (see DEPLOYMENT.md) ──
# Content now lives in Postgres (DATABASE_URL above — the website needs it
# too; `docker compose up -d` gives you one locally). DATA_DIR is only where the
# website looks, once, for the old JSON-file store to import into the database.
DATA_DIR="/var/lib/spbuilders"
# Shared secret the admin sends when publishing. Unset in production means
# publishing is disabled (fail closed), never "open to everyone".
PUBLISH_TOKEN=""
NEXT_PUBLIC_PUBLISH_TOKEN=""
# Restricts CORS on the publish endpoints to the admin's origin.
ADMIN_ORIGIN="http://localhost:3005"
# Where the admin publishes to.
NEXT_PUBLIC_WEBSITE_URL="http://localhost:3000"
# Admin console sign-in (mock auth until the API lands). Set these in
# production so the working password is not the committed default.
NEXT_PUBLIC_ADMIN_EMAIL="admin@royalnestrealty.in"
NEXT_PUBLIC_ADMIN_PASSWORD=""
