# ─────────────────────────────────────────────────────────────
# SP Builders — Environment Variables (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# ── Core ──
NODE_ENV=development

# ── API (NestJS) ──
API_PORT=4000
API_GLOBAL_PREFIX=api
API_VERSION=1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── PostgreSQL / Prisma ──
DATABASE_URL="postgresql://spb:spb@localhost:5432/spbuilders?schema=public"
# Direct URL for migrations when using a pooled connection (e.g. PgBouncer/Supabase)
DIRECT_URL="postgresql://spb:spb@localhost:5432/spbuilders?schema=public"

# ── Redis (cache, queues, socket adapter) ──
REDIS_URL="redis://localhost:6379"

# ── JWT / Auth ──
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="30d"
BCRYPT_ROUNDS=12

# ── Google OAuth ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# ── AWS S3 (compatible storage: AWS / MinIO / R2) ──
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="spb-media"
S3_PUBLIC_URL="http://localhost:9000/spb-media"
S3_FORCE_PATH_STYLE=true

# ── Notifications ──
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SP Builders <no-reply@spbuilders.com>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# ── Frontend (Next.js public vars) ──
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GA_ID=""

# ── Production content store & publish auth (see DEPLOYMENT.md) ──
# Where published gallery/marketing/settings/layout JSON is kept. Defaults to
# the OS temp dir, which is wiped on a server — always set this in production.
DATA_DIR="/var/lib/spbuilders"
# Shared secret the admin sends when publishing. Unset in production means
# publishing is disabled (fail closed), never "open to everyone".
PUBLISH_TOKEN=""
NEXT_PUBLIC_PUBLISH_TOKEN=""
# Restricts CORS on the publish endpoints to the admin's origin.
ADMIN_ORIGIN="http://localhost:3005"
# Where the admin publishes to.
NEXT_PUBLIC_WEBSITE_URL="http://localhost:3000"
# Admin console sign-in (mock auth until the API lands). Set these in
# production so the working password is not the committed default.
NEXT_PUBLIC_ADMIN_EMAIL="admin@royalnestrealty.in"
NEXT_PUBLIC_ADMIN_PASSWORD=""
