{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "SP Builders base config",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,

    "baseUrl": ".",
    "paths": {
      "@spb/types": ["packages/types/src"],
      "@spb/types/*": ["packages/types/src/*"],
      "@spb/utils": ["packages/utils/src"],
      "@spb/utils/*": ["packages/utils/src/*"],
      "@spb/ui": ["packages/ui/src"],
      "@spb/ui/*": ["packages/ui/src/*"],
      "@spb/hooks": ["packages/hooks/src"],
      "@spb/hooks/*": ["packages/hooks/src/*"],
      "@spb/components": ["packages/components/src"],
      "@spb/components/*": ["packages/components/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "build", "coverage"]
}
