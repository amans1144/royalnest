# ============================================================================
#  RoyalNest — PRODUCTION environment. Copy to .env.production and fill in.
#
#      cp .env.prod.example .env.production && chmod 600 .env.production
#
#  .env.production is gitignored and must never be committed.
#  `bash deploy.sh` → 1) Setup / Configure walks through every value below and
#  can generate the secrets for you.
#
#  ── Build-time vs runtime ──────────────────────────────────────────────────
#  Everything starting with NEXT_PUBLIC_ is inlined into the browser bundle
#  when the image is built. Changing one of those means a REBUILD
#  (deploy.sh → 2), not a restart. Everything else is read at runtime, so a
#  restart is enough.
# ============================================================================

NODE_ENV=production

# ── Proxy / edge ────────────────────────────────────────────────────────────
# The apex domain. www. and admin. are derived from it by the proxy.
PROXY_DOMAIN=royalnestrealty.in
# true  → Caddy serves plain HTTP on the loopback port below and the VPS host
#         nginx terminates TLS (the deployed default; see deploy/nginx/).
# false → Caddy itself owns 80/443 and obtains its own Let's Encrypt certs.
#         Use deploy.sh -> 4 -> f to switch modes safely. If you set it here,
#         also set PROXY_BIND=0.0.0.0, PROXY_HTTP_PORT=80, PROXY_HTTPS_PORT=443
#         and stop the host nginx, or the ports will collide.
PROXY_INTERNAL=true
PROXY_BIND=127.0.0.1
# 8088/8443 are already taken on this VPS by the musicalarchive proxy — do not reuse.
PROXY_HTTP_PORT=8090
PROXY_HTTPS_PORT=8453
# Let's Encrypt registration address. Required when PROXY_INTERNAL=false;
# unused in the default nginx+certbot mode, where certbot asks for it instead.
ACME_EMAIL=

# ── Website (build-time) ────────────────────────────────────────────────────
# Canonical tags, OG URLs, sitemap and robots.txt are generated from this.
NEXT_PUBLIC_SITE_URL=https://royalnestrealty.in
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
# robots.txt only allows indexing on a non-localhost https origin. Leave empty
# unless you deliberately want a staging domain indexed.
NEXT_PUBLIC_ALLOW_INDEXING=

# ── Publishing (website runtime + admin build-time) ─────────────────────────
# Generate with: openssl rand -hex 32
# These two MUST be identical, or the admin's publishes are rejected with 401.
# Unset on the website means publishing is disabled entirely (fails closed).
PUBLISH_TOKEN=
NEXT_PUBLIC_PUBLISH_TOKEN=
# Restricts CORS on the publish endpoints to the admin's origin.
ADMIN_ORIGIN=https://admin.royalnestrealty.in
# Where the admin sends its publishes.
NEXT_PUBLIC_WEBSITE_URL=https://royalnestrealty.in

# ── Admin sign-in (build-time) ─────────────────────────────────────────────
# The admin's own sign-in is a client-side mock: these end up readable in the
# JS bundle. nginx Basic Auth (deploy/nginx/) is what actually keeps strangers
# out. Change these from the committed defaults regardless.
NEXT_PUBLIC_ADMIN_EMAIL=admin@royalnestrealty.in
NEXT_PUBLIC_ADMIN_PASSWORD=

# ── API + datastores ───────────────────────────────────────────────────────
# The API is still a scaffold and nothing on the site calls it. These must be
# filled in anyway if you run it, because it validates its env at boot and
# exits if they are missing or too short.
API_PORT=4000
API_GLOBAL_PREFIX=api
API_VERSION=1
CORS_ORIGINS=https://royalnestrealty.in,https://admin.royalnestrealty.in

DB_USERNAME=spb
DB_PASSWORD=
DB_NAME=spbuilders
# Hostnames are compose service names — resolvable only inside the stack.
DATABASE_URL=postgresql://spb:CHANGE_ME@postgres:5432/spbuilders?schema=public
DIRECT_URL=postgresql://spb:CHANGE_ME@postgres:5432/spbuilders?schema=public

REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379

# Minimum 16 characters each; generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ── Optional integrations ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://royalnestrealty.in/api/v1/auth/google/callback
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=spb-media
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RoyalNest <no-reply@royalnestrealty.in>

# ── Backups (deploy.sh → 6) ────────────────────────────────────────────────
# Local backup directory on the VPS, and how many to keep.
BACKUP_DIR=/var/backups/royalnest
RETAIN_LOCAL_MAX=14
