{
  "name": "spbuilders",
  "version": "0.1.0",
  "private": true,
  "description": "SP Builders — Enterprise Real Estate Platform (monorepo)",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @spb/api prisma:generate",
    "db:migrate": "pnpm --filter @spb/api prisma:migrate",
    "db:seed": "pnpm --filter @spb/api prisma:seed",
    "db:studio": "pnpm --filter @spb/api prisma:studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
